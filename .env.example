# Leave blank to auto-detect: Android emulator → 10.0.2.2, iOS/desktop → 127.0.0.1
# Set explicitly only for LAN/remote. Example: API_BASE_URL=http://192.168.1.100:8000
API_BASE_URL=

# Google Sign-In "Web application" OAuth client ID from Google Cloud Console.
# Must be the EXACT SAME value as GOOGLE_CLIENT_ID in backend/.env -- this is
# the audience the backend checks the ID token against.
GOOGLE_SERVER_CLIENT_ID=

# Facebook App ID is NOT read from here -- it's compiled into the Android
# build from android/app/src/main/res/values/strings.xml. Edit that file
# directly with your real Facebook App ID/Client Token.
