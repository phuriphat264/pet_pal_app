# ============================================================
# PetPal Production Environment — copy to .env on the server
# Replace ALL values marked <CHANGE_ME> before deploying
# ============================================================

# --- Gemini (AI match enrichment) ---
GEMINI_API_KEY=<CHANGE_ME>
MATCH_CACHE_TTL_SECONDS=600
GEMINI_MAX_CONCURRENT=3
MATCH_TIMEOUT_SECONDS=8

# --- Database ---
POSTGRES_USER=petpal
POSTGRES_PASSWORD=<CHANGE_ME_strong_password>
POSTGRES_DB=petpal
# DATABASE_URL is built automatically by docker-compose.prod.yml from the above

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<CHANGE_ME_run_command_above>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Social login ---
GOOGLE_CLIENT_ID=<CHANGE_ME_or_leave_blank>
FACEBOOK_APP_ID=<CHANGE_ME_or_leave_blank>
FACEBOOK_APP_SECRET=<CHANGE_ME_or_leave_blank>

# --- SMTP ---
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=<CHANGE_ME>
SMTP_PASSWORD=<CHANGE_ME>
SMTP_FROM=PetPal <no-reply@YOUR_DOMAIN.com>
SMTP_USE_TLS=true

# --- MinIO (S3-compatible) ---
S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_ENDPOINT_URL = the URL users' phones use to reach MinIO presigned URLs
# If routing MinIO through Nginx at /minio/: https://YOUR_DOMAIN.com/minio
# Or expose port 9000 directly:             https://YOUR_DOMAIN.com:9000
S3_PUBLIC_ENDPOINT_URL=https://YOUR_DOMAIN.com/minio
S3_ACCESS_KEY=petpal
S3_SECRET_KEY=<CHANGE_ME_strong_password>
S3_BUCKET=petpal
S3_REGION=us-east-1

# --- Camera encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_SECRET_KEY=<CHANGE_ME_run_command_above>

# --- LiveKit ---
LIVEKIT_API_KEY=petpal-lk
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_API_SECRET=<CHANGE_ME_min_32_chars>
# Must be reachable from the phone app (use public IP or domain)
LIVEKIT_PUBLIC_URL=wss://YOUR_DOMAIN.com/livekit

# --- Seed accounts (created once on first run) ---
SEED_ADMIN_EMAIL=admin@YOUR_DOMAIN.com
SEED_ADMIN_PASSWORD=<CHANGE_ME_strong_password>
SEED_TECHNICIAN_EMAIL=technician@YOUR_DOMAIN.com
SEED_TECHNICIAN_PASSWORD=<CHANGE_ME_strong_password>
