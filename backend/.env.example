GEMINI_API_KEY=

# Optional tuning for the cache + request queue in front of Gemini.
# How long a successful (non-fallback) match result is cached, in seconds.
MATCH_CACHE_TTL_SECONDS=600
# How many requests can call Gemini at the same time (keeps us under
# Gemini's per-minute rate limit even with several users at once).
GEMINI_MAX_CONCURRENT=3
# How long /api/match waits for the Gemini enrichment before falling back
# to the (already returned) local vector-search result's plain reason text.
MATCH_TIMEOUT_SECONDS=8

# --- Database ---
# POSTGRES_USER/PASSWORD/DB are used by docker-compose.yml both to configure
# the postgres container AND to build the backend's DATABASE_URL when running
# via `docker compose up` -- change these (especially the password) before
# any real deployment, since the defaults below are publicly visible in this
# repo's example file.
POSTGRES_USER=petpal
POSTGRES_PASSWORD=petpal
POSTGRES_DB=petpal
# DATABASE_URL below is only used when running the backend directly with
# `uvicorn --reload` against the dockerized Postgres from your host machine
# (host port 5433, not the default 5432, to avoid clashing with other local
# Postgres instances). Keep it in sync with POSTGRES_USER/PASSWORD/DB above.
DATABASE_URL=postgresql+asyncpg://petpal:petpal@localhost:5433/petpal

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Social login (leave blank to disable; buttons will show an error) ---
# Google Cloud Console > APIs & Services > Credentials > Create Credentials
# > OAuth client ID > Application type "Web application". Use ITS client ID
# here AND as GOOGLE_SERVER_CLIENT_ID in the Flutter app's .env -- they must
# match exactly, since this is the audience the ID token is checked against.
# You also need a second OAuth client of type "Android" (package name
# com.yourname.pet_pal_app + your debug/release SHA-1) for Google Sign-In
# itself to work on Android, but that one's ID is never copied anywhere.
GOOGLE_CLIENT_ID=
# Facebook Developer Console (developers.facebook.com) > your app > Settings
# > Basic. App ID also goes in the Flutter app's .env as FACEBOOK_APP_ID.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Outgoing email (password reset codes) ---
# Leave blank in dev: the reset code is logged to the backend console
# instead of actually being emailed. Any standard SMTP provider works
# (Gmail app password, SendGrid, Mailtrap, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PetPal <no-reply@petpal.app>
SMTP_USE_TLS=true

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=petpal
S3_SECRET_KEY=petpal12345
S3_BUCKET=petpal
S3_REGION=us-east-1

# --- Camera credential encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_SECRET_KEY=

# --- LiveKit (self-hosted voice/video calls in chat) ---
# Any key/secret pair works -- they just have to match between the backend
# and the `livekit` container (see docker-compose.yml's LIVEKIT_CONFIG).
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-livekit-secret-change-me-min-32-bytes
# LIVEKIT_PUBLIC_URL must be reachable from the phone, not just the backend
# container: your machine's LAN IP for local testing (matches API_BASE_URL's
# LAN-IP pattern in the Flutter app's .env), or your server's public
# IP/domain once deployed. Going out over the public internet additionally
# requires opening the RTC UDP port range (50000-50019 by default) on the
# host firewall, since that's where the actual call media flows.
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# --- Seed accounts (created by seed.py on first run) ---
SEED_ADMIN_EMAIL=admin@petpal.app
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_TECHNICIAN_EMAIL=technician@petpal.app
SEED_TECHNICIAN_PASSWORD=ChangeMe123!
